#include <stdio.h>

int main() {
    int s;
    
    printf("Digite a senha: ");
    scanf("%d", &s);
    
    while (s != 1234) {
        printf("Senha incorreta. Tente novamente.\n");
        printf("Digite a senha: ");
        scanf("%d", &s);
    }
    
    printf("Acesso autorizado.\n");
    
    return 0;
}
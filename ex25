#include <stdio.h>

int main() {
    int n, i = 1, soma = 0;
    
    printf("Digite um numero inteiro positivo: ");
    scanf("%d", &n);
    
    // Verifica se N é positivo
    if (n <= 0) {
        printf("Por favor, digite um numero positivo!\n");
        return 1;
    }
    
    // Calcula a soma de 1 até N
    while (i <= n) {
        soma += i;  // soma = soma + i
        i++;        // incrementa i
    }
    
    printf("A soma de 1 ate %d e: %d\n", n, soma);
    
    return 0;
}
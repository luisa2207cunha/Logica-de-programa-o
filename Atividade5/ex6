#include <stdio.h>

int main() {
    int vetor[10];
    int i;
    int maior, menor;

    printf("Digite 10 numeros inteiros:\n");
    for (i = 0; i < 10; i++) {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }

    // Inicializa maior e menor com o primeiro elemento
    maior = vetor[0];
    menor = vetor[0];

    // Percorre o vetor para encontrar o maior e o menor
    for (i = 1; i < 10; i++) {
        if (vetor[i] > maior) {
            maior = vetor[i];
        }
        if (vetor[i] < menor) {
            menor = vetor[i];
        }
    }

    // Exibe os resultados
    printf("\nMaior elemento do vetor: %d\n", maior);
    printf("Menor elemento do vetor: %d\n", menor);

    return 0;
}
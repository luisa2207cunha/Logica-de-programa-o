#include <stdio.h>

int main() {
    int vetor[5];
    int i;
    int maior, menor;
    float media;

    printf("Digite 5 numeros inteiros:\n");
    for (i = 0; i < 5; i++) {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }

    // Inicializa maior e menor com o primeiro elemento
    maior = vetor[0];
    menor = vetor[0];

    // Percorre o vetor para encontrar o maior e o menor
    for (i = 1; i < 5; i++) {
        if (vetor[i] > maior) {
            maior = vetor[i];
        }
        if (vetor[i] < menor) {
            menor = vetor[i];
        }
    }

    media = (float)(maior + menor) / 2;

    printf("\nMaior elemento do vetor: %d\n", maior);
    printf("Menor elemento do vetor: %d\n", menor);
    printf("A media entre o maior e o menor: %.2f\n", media);

    return 0;
}
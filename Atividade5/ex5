#include <stdio.h>

int main() {
    int vetor[10];
    int contador_pares = 0;
    
    printf("Digite 10 valores inteiros:\n");
    for (int i = 0; i < 10; i++) {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }
    
    // Contando os valores pares
    for (int i = 0; i < 10; i++) {
        if (vetor[i] % 2 == 0) {
            contador_pares++;
        }
    }
    
    printf("\nVetor digitado: ");
    for (int i = 0; i < 10; i++) {
        printf("%d ", vetor[i]);
    }
    
    printf("\n\nQuantidade de valores pares: %d\n", contador_pares);
    
    return 0;
}
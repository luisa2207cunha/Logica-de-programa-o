#include <stdio.h>

int main() {
    int n1, n2;
    int soma, mult, subt, divisao;
    
    printf("Digite o primeiro número: ");
    scanf("%d", &n1);
    
    printf("Digite o segundo número: ");
    scanf("%d", &n2);
    
    soma = n1 + n2;
    
    subt = n1 - n2;
    
    mult = n1 * n2;
    
    divisao = n1 / n2;
    
    printf("A soma dos dois números é: %d\n", soma);
    printf("A subtração dos dois números é: %d\n", subt);
    printf("A multiplicação dos dois números é: %d\n", mult);
    printf("A divisão dos dois números é: %d\n", divisao);
    
    return 0;
}
#include <stdio.h>

int main()
{
    float n1, n2, n3, m;

    printf("Digite sua nota na primeira prova: ");
    scanf("%f", &n1);

    printf("Digite sua nota na segunda prova: ");
    scanf("%f", &n2);

    printf("Digite sua nota na terceira prova: ");
    scanf("%f", &n3);

    m = (n1 + n2 + n3) / 3.0f;

    printf("Sua media foi: %.2f\n", m);

    if (m >= 70)
    {
        printf("Voce esta aprovado\n");
    }
    else if (m >= 50 && m < 70)
    {
        printf("Voce esta em recuperacao\n");
    }
    else
    {
        printf("Voce esta reprovado\n");
    }

    return 0;
}
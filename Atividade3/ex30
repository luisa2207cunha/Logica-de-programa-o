#include <stdio.h>

int main() {
    int opcao;
    float saldo = 1000.00;  // saldo inicial
    float valor;
    
    printf("Saldo inicial: R$ %.2f\n\n", saldo);
    
    while (1) {
        printf("1. Consultar saldo\n");
        printf("2. Depositar\n");
        printf("3. Sacar\n");
        printf("4. Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);
        
        switch (opcao) {
            case 1:
                // Consultar saldo
                printf("\n>>> Saldo atual: R$ %.2f\n", saldo);
                break;
                
            case 2:
                // Depositar
                printf("\nDigite o valor do deposito: R$ ");
                scanf("%f", &valor);
                
                if (valor > 0) {
                    saldo += valor;
                    printf("Deposito realizado com sucesso!\n");
                    printf("Novo saldo: R$ %.2f\n", saldo);
                } else {
                    printf("Valor invalido! O deposito deve ser positivo.\n");
                }
                break;
                
            case 3:
                // Sacar
                printf("\nDigite o valor do saque: R$ ");
                scanf("%f", &valor);
                
                if (valor <= 0) {
                    printf("Valor invalido! O saque deve ser positivo.\n");
                } else if (valor > saldo) {
                    printf("Saldo insuficiente!\n");
                    printf("Saldo disponivel: R$ %.2f\n", saldo);
                } else {
                    saldo -= valor;
                    printf("Saque realizado com sucesso!\n");
                    printf("Novo saldo: R$ %.2f\n", saldo);
                }
                break;
                
            case 4:
                // Sair
                printf("\nEncerrando o sistema. Ate logo!\n");
                return 0;
                
            default:
                printf("\nOpcao invalida! Tente novamente.\n");
        }
    }
    
    return 0;
}
#include <stdio.h>
#include <string.h>
#include <locale.h>

int main()
{
    setlocale(LC_ALL, "Portuguese");
    
    int n1, n2, n3, s;
    
    printf("Digite o primeiro numero: ");
    scanf("%d", &n1);
    
     printf("Digite o segundo numero: ");
    scanf("%d", &n2);
    
     printf("Digite o terceiro numero: ");
    scanf("%d", &n3);
    
    s = n1 + n2;
    
    if(s > n3){
        printf("A soma é maior que %d\n", n3);
    }
    else{
        printf("A soma é menor que %d\n", n3);
    }
    
    
    return 0;
}
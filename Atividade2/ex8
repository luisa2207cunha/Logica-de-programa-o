#include <stdio.h>

int main() {
    int a, b, c;
    int maior, medio, menor;
    
    printf("Digite tres numeros inteiros diferentes entre si:\n");
    printf("Primeiro numero : ");
    scanf("%d", &a);
    printf("Segundo numero: ");
    scanf("%d", &b);
    printf("Terceiro numero: ");
    scanf("%d", &c);
    
    // Verificação se os valores são realmente diferentes
    if (a == b || a == c || b == c) {
        printf("\nOs numeros devem ser diferentes.\n");
        return 1; 
    }
    
    // Encontrando o maior valor
    if (a > b && a > c) {
        maior = a;
    } else if (b > a && b > c) {
        maior = b;
    } else {
        maior = c;
    }
    
    // menor valor
    if (a < b && a < c) {
        menor = a;
    } else if (b < a && b < c) {
        menor = b;
    } else {
        menor = c;
    }
    
    // O valor médio
    if (a != maior && a != menor) {
        medio = a;
    } else if (b != maior && b != menor) {
        medio = b;
    } else {
        medio = c;
    }
    
    // Exibição dos valores em ordem decrescente
    printf("%d, %d, %d\n", maior, medio, menor);
    
    return 0;
}
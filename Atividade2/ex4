#include <stdio.h>
#include <string.h>
#include <locale.h>

int main()
{
    setlocale(LC_ALL, "Portuguese");
    
    int n1, n2, s, m;
    
    printf("Digite o primeiro numero: ");
    scanf("%d", &n1);
    
    printf("Digite o segundo numero: ");
    scanf("%d", &n2);
    
    
    if(n1 == n2){
       s = n1 + n2;
        printf("A soma é %d\n", s);
    }
    else{
        m = n1 * n2;
        printf("A multiplicação %d\n", m);
    }
    
    
    return 0;
}
#include <stdio.h>

int main()
{
    int n, s1, s2;
    
    printf("Digite um numero: ");
    scanf("%d", &n);
    
    if(n % 2 == 0){
        s1 = n + 5;
        
        printf("Aqui está o seu numero mais 5: %d\n", s1);
    } else{
        s2 = n + 8;
        
        printf("Aqui está o seu numero mais 8: %d\n", s2);
    }

    return 0;
}
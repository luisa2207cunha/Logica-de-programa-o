#include <stdio.h>

int main()
{
    float p, imc, h;
   
    printf("Por favor digite seu peso: ");
    scanf("%f", &p);   
    
    printf("Agora digite sua altura: ");
    scanf("%f", &h);
    
    imc = p / (h * h);
    
    if (imc < 18.5)
    {
        printf("Você está abaixo do peso.");
    }
    else if (18.5< imc > 25){
        printf("Você está com o peso normal.");
    }
    else if (25< imc > 30){
        printf("Você está acima do peso.");
    }
    
    else 
    {
        printf("Você ésta obeso");
    }

    return 0;
}
#include <stdio.h>
#include <string.h>
#include <locale.h>

int main()
{
    setlocale(LC_ALL, "Portuguese");
    
    int n1, d, t;
    
    printf("Digite o primeiro numero: ");
    scanf("%d", &n1);
    
    if(n1 > 0){
       d = n1 + n1;
        printf("O dobro é %d\n", d);
    }
    else{
        t = n1 + n1 + n1;
        printf("O triplo é %d\n", t);
    }
    
    
    return 0;
}
#include <stdio.h>
#include <string.h>
#include <locale.h>

int main()
{
    setlocale(LC_ALL, "Portuguese");
    
    int n1;
    
    printf("Digite o seu numero: ");
    scanf("%d", &n1);
    
    if(n1 > 0){
        printf("O numero é positivo");
    }
    else if(n1 < 0){
        printf("O numero é negativo");
    }
    else{
    
        printf("O numero é nulo");
    }
    
    
    return 0;
}